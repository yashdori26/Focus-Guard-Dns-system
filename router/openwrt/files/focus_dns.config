# FocusDNS UCI Configuration File for OpenWrt
# Location: /etc/config/focus_dns
#
# Provides enterprise DNS enforcement, device-level profile assignment,
# and anti-bypass packet redirection on home and campus Wi-Fi networks.

config global 'settings'
	option enabled '1'
	option profile_id 'profile_home_primary'
	option primary_server '127.0.0.1'
	option primary_port '5353'
	option upstream_protocol 'dot'
	option upstream_dot_server 'dns.focusguard.io'
	option upstream_dot_port '853'
	option failsafe_enabled '1'
	option failsafe_fallback_ip '127.0.0.1'
	option failsafe_fallback_port '53'
	option block_rogue_doh '1'
	option block_rogue_dot '1'
	option force_ntp_sync '1'
	option edns_client_subnet '1'
	option log_level 'info'

config client 'living_room_tv'
	option mac_address 'AA:BB:CC:11:22:33'
	option hostname 'LG-WebOS-OLED'
	option assigned_profile 'profile_ad_free_iot'
	option device_category 'SmartTV'
	option strict_lock '0'

config client 'kids_ipad'
	option mac_address 'D8:9E:3F:44:55:66'
	option hostname 'Sarahs-iPad-Mini'
	option assigned_profile 'profile_strict_kids'
	option device_category 'Tablet'
	option strict_lock '1'

config client 'work_macbook'
	option mac_address 'F0:18:98:77:88:99'
	option hostname 'MacBook-Pro-M3'
	option assigned_profile 'profile_deep_work'
	option device_category 'Laptop'
	option strict_lock '1'

config client 'guest_network_pool'
	option mac_address '00:00:00:00:00:00'
	option ip_subnet '192.168.10.0/24'
	option assigned_profile 'profile_family_safe'
	option device_category 'GuestVLAN'
	option strict_lock '0'

config bypass_rule 'exempt_emergency'
	option name 'National Emergency Services'
	option destination_port '53'
	option enabled '1'
	option description 'Ensures 911/112 VoIP dialers and safety beacons are never impeded'

config bypass_rule 'exempt_openwrt_ntp'
	option name 'OpenWrt Network Time'
	option destination_ip 'pool.ntp.org'
	option destination_port '123'
	option enabled '1'
	option description 'Preserves system clock synchronization for TLS certificates'
