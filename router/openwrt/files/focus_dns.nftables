#!/usr/sbin/nft -f
# FocusDNS Modern nftables Ruleset for OpenWrt 22.03+ / 23.05+
# Location: /usr/share/focus_dns/focus_dns.nftables
#
# Enforces zero-bypass DNS interception on all LAN bridge interfaces (br-lan),
# isolates IoT / Smart TVs, blocks rogue DoH resolvers, and preserves DHCP/NTP.

table inet focus_dns {
	# Set of known public DoH resolvers hardcoded in rogue browser bypasses
	set rogue_doh_resolvers {
		type ipv4_addr
		flags interval
		elements = {
			1.1.1.1, 1.0.0.1,             # Cloudflare
			8.8.8.8, 8.8.4.4,             # Google
			9.9.9.9, 149.112.112.112,     # Quad9
			208.67.222.222, 208.67.220.220, # OpenDNS
			94.140.14.14, 94.140.15.15,   # AdGuard
			45.90.28.0/24, 45.90.30.0/24  # NextDNS
		}
	}

	# NAT chain for redirecting unencrypted DNS port 53 to local FocusDNS daemon
	chain prerouting {
		type nat hook prerouting priority dstnat - 100; policy accept;

		# Life Safety Exemption: Do not touch localhost loopback traffic
		iif "lo" accept

		# Intercept standard UDP DNS on LAN interfaces and redirect to local daemon port 5353
		iifname { "br-lan", "eth1", "lan" } udp dport 53 redirect to :5353

		# Intercept standard TCP DNS on LAN interfaces and redirect to local daemon port 5353
		iifname { "br-lan", "eth1", "lan" } tcp dport 53 redirect to :5353
	}

	# Forward filter chain for intercepting encrypted bypass attempts (DoH / DoT)
	chain forward {
		type filter hook forward priority filter - 10; policy accept;

		# Drop direct HTTPS connections to rogue public DoH resolvers
		ip daddr @rogue_doh_resolvers tcp dport 443 counter drop comment "Drop rogue public DoH bypass attempt"

		# Drop unauthorized DoT (port 853) connections bypassing FocusDNS daemon
		tcp dport 853 counter drop comment "Drop unauthorized port 853 DoT bypass attempt"
	}

	# Output chain for daemon outbound protection
	chain output {
		type route hook output priority filter; policy accept;

		# Ensure router daemon itself can connect to FocusDNS upstream DoT port 853
		skuid "focus_dns" tcp dport 853 accept
	}
}
