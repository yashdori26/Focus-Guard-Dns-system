<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Debug configuration: permit cleartext traffic to any development server (emulator 10.0.2.2, localhost, LAN IPs like 192.168.x.x) -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
